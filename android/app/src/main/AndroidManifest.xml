<?xml version="1.0" encoding="utf-8"?>
<!--
  M13b spike manifest.

  * configChanges is deliberately narrow: only the hardware-keyboard entries,
    which the soft IME does not touch. Rotation, font scale, density, dark mode
    and locale all recreate the Activity — that is the behaviour check (2)
    needs to observe.
  * screenOrientation="unspecified": the owner can rotate the phone; the
    recreation is part of the test.
  * No permissions: this spike does no I/O beyond its own files dirs. The crash
    files moved to app-specific external storage in v2.1, which needs no
    permission either.
  * The FileProvider is the crash banner's "Share log" route: it hands
    spike-last-crash.txt to the share sheet as a content:// URI with a one-shot
    read grant. `androidx.core.content.FileProvider` ships in androidx.core
    (already on the classpath through appcompat), so no dependency was added.

  The activity extends com.google.androidgamesdk.GameActivity, so the theme must
  be an AppCompat descendant (GameActivity extends AppCompatActivity).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M13d: the model download is the app's first network use (HuggingFace,
         https only). POST_NOTIFICATIONS is the API 33+ runtime permission for
         the progress notification; without it the job still runs, silently.
         The dataSync foreground-service type needs its own permission from
         API 34 — declared here, harmless below. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".SpikeApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuramakSpike">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- M13d: the model download job. `BIND_JOB_SERVICE` is mandatory for
             every JobService (the platform binds it); `exported=false` keeps
             other apps out. `foregroundServiceType="dataSync"` is the type the
             plan names — Android 15's six-hour limit and Service.onTimeout
             apply to that type, and the service promotes itself to the
             foreground when the job starts. -->
        <service
            android:name="app.suramak.models.ModelDownloadJobService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- M13d: the progress notification's Cancel action. -->
        <receiver
            android:name="app.suramak.models.CancelModelDownloadReceiver"
            android:exported="false" />
    </application>

</manifest>
