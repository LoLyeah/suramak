<resources>
    <string name="app_name">Suramak Spike</string>

    <!-- M13d: the model landing copy. The same sentences are produced by
         `suramak_core::device` for the bridge (LANDING_EN / LANDING_ID); these
         resources are what the compact UI will render in M13g. -->
    <string name="model_landing_title">Models for this phone</string>
    <string name="model_landing_body">base and small are the on-device defaults; tiny is only for quick tests. Phones with 8 GB or more run small best.</string>
    <string name="model_landing_id_note">Indonesian: avoid tiny — its Indonesian accuracy is noticeably worse. Use base or small.</string>
    <string name="model_landing_floor_note">Suramak needs a 64-bit ARM phone with at least 4 GB of RAM. Below that only tiny runs.</string>

