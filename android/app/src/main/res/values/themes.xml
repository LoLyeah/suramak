<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      GameActivity extends AppCompatActivity, so the theme must descend from an
      AppCompat theme (otherwise the Activity throws "You need to use a
      Theme.AppCompat theme" before our code runs). NoActionBar because the UI is
      egui; the system bars stay visible on purpose — check (4) needs real insets.
    -->
    <style name="Theme.SuramakSpike" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
