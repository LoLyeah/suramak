    <string name="model_landing_title">Model untuk ponsel ini</string>
    <string name="model_landing_body">base dan small adalah pilihan bawaan di perangkat; tiny hanya untuk uji cepat. Ponsel dengan RAM 8 GB atau lebih paling baik menjalankan small.</string>
